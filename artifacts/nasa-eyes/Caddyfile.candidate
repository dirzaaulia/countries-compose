control.168.110.196.30.sslip.io {
    root * /var/www/dashboard
    file_server
}

files.168.110.196.30.sslip.io, files.fc.dirzaaulia.com {
    handle /countries/textures/* {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Allow-Headers "Range"
        header X-Content-Type-Options "nosniff"
        @eyesRelease path /countries/textures/eyes-v1/*
        header @eyesRelease Cache-Control "public, max-age=31536000, immutable"
        @texturePreflight method OPTIONS
        respond @texturePreflight 204
        root * /var/www/cloud
        file_server
    }
    handle {
        reverse_proxy jarvis-filebrowser:80
    }
}

168.110.196.30.sslip.io, api.fc.dirzaaulia.com, edge.fc.dirzaaulia.com {
    @rest path /rest/v1/*
    handle @rest {
        uri strip_prefix /rest/v1
        reverse_proxy jarvis-postgrest:3000 {
            header_up -Authorization
            header_up -apikey
        }
    }
    @auth path /auth/*
    handle @auth {
        reverse_proxy https://eiomktvavndorazreyba.supabase.co {
            header_up Host eiomktvavndorazreyba.supabase.co
        }
    }
    handle {
        reverse_proxy jarvis-postgrest:3000 {
            header_up -Authorization
            header_up -apikey
        }
    }
}
